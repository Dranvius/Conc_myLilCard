PORT=4000
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SECRET_KEY=replace_with_your_real_hcaptcha_secret
CORS_ORIGIN=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
FRONTEND_URL=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
GOOGLE_CALLBACK_URL=https://${{web.RAILWAY_PUBLIC_DOMAIN}}/api/auth/google/callback
COOKIE_DOMAIN=
INITIAL_ADMIN_EMAIL=admin@your-company.com
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_admin_password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
