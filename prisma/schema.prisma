generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  LEAD
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OpportunityStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SaleStatus {
  PENDING
  CONFIRMED
  CLOSED
  CANCELLED
}

enum ServiceOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum CustomerType {
  PATIENT
  PROFESSIONAL
  INSTITUTION
  DISTRIBUTOR
}

enum LeadSource {
  WEB_FORM
  WHATSAPP
  PHONE
  REFERRAL
  SOCIAL_MEDIA
  CONGRESS
  COLD_CALL
  OTHER
}

enum LostReason {
  PRICE
  COMPETITION
  NO_BUDGET
  NO_RESPONSE
  TIMING
  OTHER
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  WHATSAPP
}

enum ProductSegment {
  AMBULATORY
  HOSPITAL
  BOTH
}

enum NotificationType {
  GENERAL
  PUBLIC_LEAD
  OPPORTUNITY_ASSIGNED
  ACTIVITY_DUE
  ACTIVITY_OVERDUE
  PROPOSAL_EXPIRING
  INVOICE_OVERDUE
}

model User {
  id                    String             @id @default(cuid())
  name                  String
  email                 String             @unique
  passwordHash          String?
  googleId              String?            @unique
  authProvider          String             @default("LOCAL")
  avatarUrl             String?
  roleId                String
  businessUnitId        String?
  refreshTokenHash      String?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  role                  Role               @relation(fields: [roleId], references: [id])
  businessUnit          BusinessUnit?      @relation(fields: [businessUnitId], references: [id])
  ownedOpportunities    SalesOpportunity[] @relation("OpportunityOwner")
  sales                 Sale[]             @relation("SaleOwner")
  assignedServiceOrders ServiceOrder[]     @relation("AssignedOperator")
  auditLogs             AuditLog[]
  notifications         Notification[]
  activities            Activity[]
  opportunityStageChanges OpportunityStageHistory[] @relation("OpportunityStageChangedBy")
  stats                 UserStats?
  badges                UserBadge[]
  pointActions          PointAction[]

  @@index([email])
  @@index([roleId])
  @@index([businessUnitId])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model BusinessUnit {
  id            String             @id @default(cuid())
  name          String             @unique
  description   String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  users         User[]
  companies     Company[]
  products      Product[]
  opportunities SalesOpportunity[]
  assignmentRules AssignmentRule[]

  @@index([createdAt])
}

model Company {
  id             String             @id @default(cuid())
  name           String
  legalName      String?
  customerType   CustomerType       @default(INSTITUTION)
  taxId          String?            @unique
  phone          String?
  email          String?
  website        String?
  address        String?
  city           String?
  country        String?
  latitude       Float?
  longitude      Float?
  businessUnitId String
  status         CompanyStatus
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  businessUnit   BusinessUnit       @relation(fields: [businessUnitId], references: [id])
  contacts       Contact[]
  opportunities  SalesOpportunity[]
  sales          Sale[]
  serviceOrders  ServiceOrder[]
  invoices       Invoice[]
  reviews        Review[]
  activities     Activity[]

  @@index([taxId])
  @@index([businessUnitId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Contact {
  id          String               @id @default(cuid())
  companyId   String
  firstName   String
  lastName    String
  position    String?
  email       String?
  phone       String?
  notes       String?
  source      LeadSource?
  deletedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  company     Company              @relation(fields: [companyId], references: [id])
  opportunities SalesOpportunity[]
  serviceOrders ServiceOrder[]
  activities    Activity[]

  @@index([companyId])
  @@index([email])
  @@index([source])
  @@index([createdAt])
  @@index([deletedAt])
}

model Product {
  id             String         @id @default(cuid())
  businessUnitId String
  name           String
  sku            String         @unique
  category       String
  description    String?
  unitPrice      Decimal        @db.Decimal(12, 2)
  stock                Int            @default(0)
  brand                String?
  model                String?
  imageUrl             String?
  specifications       Json?
  targetSegment        ProductSegment @default(BOTH)
  requiresPrescription Boolean        @default(false)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  businessUnit         BusinessUnit   @relation(fields: [businessUnitId], references: [id])
  proposalItems        ProposalItem[]

  @@index([businessUnitId])
  @@index([category])
  @@index([isActive])
  @@index([createdAt])
}

model SalesOpportunity {
  id                String           @id @default(cuid())
  companyId         String
  contactId         String?
  ownerId           String
  businessUnitId    String
  title             String
  stage             OpportunityStage
  estimatedValue    Decimal          @db.Decimal(12, 2)
  probability       Int
  expectedCloseDate DateTime?
  source            LeadSource?
  stageChangedAt    DateTime         @default(now())
  lostReason        LostReason?
  lostReasonNotes   String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company          @relation(fields: [companyId], references: [id])
  contact           Contact?         @relation(fields: [contactId], references: [id])
  owner             User             @relation("OpportunityOwner", fields: [ownerId], references: [id])
  businessUnit      BusinessUnit     @relation(fields: [businessUnitId], references: [id])
  proposals         Proposal[]
  sales             Sale[]
  activities        Activity[]
  stageHistory      OpportunityStageHistory[]

  @@index([companyId])
  @@index([contactId])
  @@index([ownerId])
  @@index([businessUnitId])
  @@index([stage])
  @@index([source])
  @@index([stageChangedAt])
  @@index([createdAt])
}

model OpportunityStageHistory {
  id            String           @id @default(cuid())
  opportunityId String
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  changedById   String?
  changedAt     DateTime         @default(now())
  metadata      Json?
  opportunity   SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  changedBy     User?            @relation("OpportunityStageChangedBy", fields: [changedById], references: [id])

  @@index([opportunityId, changedAt])
  @@index([changedById])
  @@index([toStage])
}

model Proposal {
  id          String         @id @default(cuid())
  opportunityId String
  code        String         @unique
  title       String
  status      ProposalStatus
  subtotal    Decimal        @default(0) @db.Decimal(12, 2)
  taxRate     Decimal        @default(19.00) @db.Decimal(5, 2)
  taxAmount   Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount Decimal        @db.Decimal(12, 2)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  opportunity SalesOpportunity @relation(fields: [opportunityId], references: [id])
  items       ProposalItem[]
  sales       Sale[]

  @@index([opportunityId])
  @@index([status])
  @@index([createdAt])
}

model ProposalItem {
  id        String   @id @default(cuid())
  proposalId String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  proposal  Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([proposalId])
  @@index([productId])
}

model Sale {
  id            String     @id @default(cuid())
  opportunityId String
  proposalId    String?
  companyId     String
  ownerId       String
  status        SaleStatus
  totalAmount   Decimal    @db.Decimal(12, 2)
  closedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  opportunity   SalesOpportunity @relation(fields: [opportunityId], references: [id])
  proposal      Proposal?  @relation(fields: [proposalId], references: [id])
  company       Company    @relation(fields: [companyId], references: [id])
  owner         User       @relation("SaleOwner", fields: [ownerId], references: [id])
  serviceOrders ServiceOrder[]
  invoices      Invoice[]

  @@index([opportunityId])
  @@index([proposalId])
  @@index([companyId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

model ServiceOrder {
  id                 String               @id @default(cuid())
  companyId          String
  contactId          String?
  saleId             String?
  assignedOperatorId String?
  code               String               @unique
  type               String
  priority           ServiceOrderPriority
  status             ServiceOrderStatus
  description        String
  scheduledAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  company            Company              @relation(fields: [companyId], references: [id])
  contact            Contact?             @relation(fields: [contactId], references: [id])
  sale               Sale?                @relation(fields: [saleId], references: [id])
  assignedOperator   User?                @relation("AssignedOperator", fields: [assignedOperatorId], references: [id])
  reviews            Review[]

  @@index([companyId])
  @@index([contactId])
  @@index([saleId])
  @@index([assignedOperatorId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model Invoice {
  id            String        @id @default(cuid())
  saleId        String
  companyId     String
  invoiceNumber String        @unique
  status        InvoiceStatus
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  issuedAt      DateTime
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sale          Sale          @relation(fields: [saleId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id])

  @@index([saleId])
  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

model Review {
  id             String        @id @default(cuid())
  companyId      String
  serviceOrderId String?
  rating         Int
  comment        String?
  createdAt      DateTime      @default(now())
  company        Company       @relation(fields: [companyId], references: [id])
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  @@index([companyId])
  @@index([serviceOrderId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  title         String
  message       String
  type          NotificationType @default(GENERAL)
  referenceType String?
  referenceId   String?
  dedupeKey     String?          @unique
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model AssignmentCursor {
  id             String   @id @default(cuid())
  scopeKey       String   @unique
  entityType     String
  roleName       String
  businessUnitId String?
  lastUserId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([entityType])
  @@index([roleName])
  @@index([businessUnitId])
  @@index([lastUserId])
}

model AssignmentRule {
  id                String       @id @default(cuid())
  name              String
  entityType        String
  isActive          Boolean      @default(true)
  priority          Int          @default(100)
  roleName          String       @default("SALES")
  businessUnitId    String?
  leadSource        LeadSource?
  city              String?
  country           String?
  minEstimatedValue Decimal?     @db.Decimal(12, 2)
  maxEstimatedValue Decimal?     @db.Decimal(12, 2)
  minProbability    Int?
  maxProbability    Int?
  priorityBand      String?
  targetUserIds     Json?
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  businessUnit      BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  @@index([entityType, isActive, priority])
  @@index([businessUnitId])
  @@index([leadSource])
  @@index([city])
}

model Activity {
  id            String       @id @default(cuid())
  type          ActivityType
  subject       String
  description   String?
  companyId     String?
  contactId     String?
  opportunityId String?
  userId        String
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company     Company?          @relation(fields: [companyId], references: [id])
  contact     Contact?          @relation(fields: [contactId], references: [id])
  opportunity SalesOpportunity? @relation(fields: [opportunityId], references: [id])
  user        User              @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([userId])
  @@index([dueDate])
  @@index([createdAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  body      String   @db.Text
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  steps     EmailSequenceStep[]

  @@index([category])
  @@index([isActive])
}

model EmailSequence {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  steps       EmailSequenceStep[]
  enrolments  EmailSequenceEnrolment[]

  @@index([isActive])
}

model EmailSequenceStep {
  id              String   @id @default(cuid())
  sequenceId      String
  templateId      String
  stepOrder       Int
  delayHours      Int      @default(24)
  sequence        EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template        EmailTemplate @relation(fields: [templateId], references: [id])
  enrolmentSteps  EmailSequenceEnrolmentStep[]

  @@unique([sequenceId, stepOrder])
  @@index([sequenceId])
  @@index([templateId])
}

model EmailSequenceEnrolment {
  id            String   @id @default(cuid())
  sequenceId    String
  contactId     String
  opportunityId String?
  status        String   @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, CANCELLED
  currentStep   Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sequence      EmailSequence @relation(fields: [sequenceId], references: [id])
  steps         EmailSequenceEnrolmentStep[]

  @@unique([sequenceId, contactId])
  @@index([sequenceId])
  @@index([contactId])
}

model EmailSequenceEnrolmentStep {
  id          String   @id @default(cuid())
  enrolmentId String
  stepId      String
  scheduledAt DateTime
  sentAt      DateTime?
  error       String?
  enrolment   EmailSequenceEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  step        EmailSequenceStep      @relation(fields: [stepId], references: [id])

  @@index([enrolmentId])
  @@index([stepId])
  @@index([scheduledAt])
}

enum PricingRuleType {
  VOLUME
  CUSTOMER_TYPE
  PRODUCT_CATEGORY
  FIXED_CAMPAIGN
}

model PricingRule {
  id             String          @id @default(cuid())
  name           String
  description    String?
  type           PricingRuleType
  isActive       Boolean         @default(true)
  priority       Int             @default(0)
  
  // Conditions
  minQuantity    Int?
  customerType   CustomerType?
  productCategory String?
  productId      String?
  businessUnitId String?
  
  // Action
  discountPercent Decimal?       @db.Decimal(5, 2)
  discountAmount  Decimal?       @db.Decimal(12, 2)
  
  validFrom      DateTime?
  validUntil     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([type, isActive, priority])
  @@index([productId])
  @@index([businessUnitId])
}

model UserStats {
  id             String   @id @default(cuid())
  userId         String   @unique
  points         Int      @default(0)
  level          Int      @default(1)
  opportunitiesWon Int     @default(0)
  activitiesDone  Int     @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  icon        String      // Nombre del icono o URL
  requirement String      // Descripción del requisito
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  unlockedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model PointAction {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
